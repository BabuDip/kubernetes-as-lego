# Copy this file to secrets.env (git-ignored) and fill in real values before
# `kubectl apply -k k8s/overlays/prod`. Never commit secrets.env.
DJANGO_SECRET_KEY=changeme
POSTGRES_USER=qless_cafe
POSTGRES_PASSWORD=changeme
# Obscures the Django admin at /<value> instead of the well-known /admin/ —
# must end with a trailing slash (used directly in config/urls.py's path()).
DJANGO_ADMIN_URL=changeme-manage/
