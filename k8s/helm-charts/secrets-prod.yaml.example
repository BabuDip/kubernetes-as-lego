# Copy this file to secrets-prod.yaml (git-ignored) and fill in real values
# before installing with -f values-prod.yaml -f secrets-prod.yaml. Never
# commit secrets-prod.yaml.
secrets:
  djangoSecretKey: changeme
  postgresUser: qless_cafe
  postgresPassword: changeme
  # Obscures the Django admin at /<value> instead of the well-known /admin/ —
  # must end with a trailing slash (used directly in config/urls.py's path()).
  djangoAdminUrl: changeme-manage/
